# Copy to .env.local, or run: npx vercel env pull .env.local
#
# EVERY VALUE HERE IS OPTIONAL. The app deploys and serves with none of them:
# pages crawl public sources live, and the API and MCP server are
# unauthenticated. Each entry below adds a capability, not a prerequisite.

# --- Store: OPTIONAL. Adds the crawl index and the change history. ---------
# Without it, pages crawl live on request and history queries say so plainly.
# (Injected automatically by `vercel integration add supabase`.)
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security by design, so it must
# never reach the browser. Every table has RLS on and revokes anon.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct connection, used only to apply supabase/schema.sql with psql.
POSTGRES_URL_NON_POOLING=

# --- Crawl trigger: OPTIONAL, and only meaningful with the store ----------
# Still required to EXPOSE the crawl endpoint: without it /api/cron/window
# refuses, because otherwise anyone could make your deployment crawl on demand.
# Must match the CRON_SECRET repository secret used by .github/workflows/crawl.yml
CRON_SECRET=

# --- Project ---------------------------------------------------------------
# Where the source lives. Linked from the nav, the footer and the docs.
NEXT_PUBLIC_REPO_URL=

# --- Branding (a rename is these three vars, not a grep) -------------------
# NEXT_PUBLIC_ because the name appears in nav and footer, which may become
# client components. Unset falls back to the defaults in lib/site.ts.
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_TAGLINE=
NEXT_PUBLIC_SITE_DESCRIPTION=

# --- Canonical URL ---------------------------------------------------------
# Drives metadataBase, sitemap, robots and every OG tag. Falls back to the
# Vercel deployment host, then localhost — so share previews and the sitemap
# are only correct once this is set.
NEXT_PUBLIC_SITE_URL=

# --- Interpretation (optional; BYOK removes the ceiling) -------------------
# Groq's free tier is ~200K tokens/day at the ORGANISATION level.
GROQ_API_KEY=
# ⚠️ Gemini's free tier may train on submitted content. Public competitor pages
# only — never user data.
GEMINI_API_KEY=
# Lifts GitHub from 60 req/hr to 5,000, and star timestamps 401 without it.
GITHUB_TOKEN=
# Finite, non-renewing credits. Used monthly per company, never per request.
SERPAPI_KEY=
